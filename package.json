{
  "name": "bb-plugin-diff-editor",
  "version": "0.1.0",
  "description": "Makes bb's diff view editable: type the fix straight into the diff and save.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CostaFot/bb-plugin-diff-editor.git"
  },
  "homepage": "https://github.com/CostaFot/bb-plugin-diff-editor#readme",
  "bugs": {
    "url": "https://github.com/CostaFot/bb-plugin-diff-editor/issues"
  },
  "keywords": [
    "bb",
    "bb-plugin",
    "diff",
    "editor",
    "monaco",
    "patch"
  ],
  "type": "module",
  "engines": {
    "bb": ">=0.42",
    "bbPluginSdk": ">=0.4.47"
  },
  "scripts": {
    "build": "bb plugin build",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build"
  },
  "bb": {
    "name": "Diff Editor",
    "description": "Edit bb's diffs in place: type the fix into the modified side and save it back to disk.",
    "branding": {
      "icon": "EditFile"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.47",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2"
  }
}
